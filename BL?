-- DEX FARM TAB
allTabFrames["dex"] = function()
    makeSectionLabel(Content,"Select Bag",0)
    local bagCard=makeCard(Content,1)
    local function refreshBagCard()
        for _,c in ipairs(bagCard:GetChildren()) do if not c:IsA("UIListLayout") then c:Destroy() end end
        for i,boxName in ipairs({"BOX1","BOX2","BOX3"}) do
            local row,lbl,div=makeFeatureRow(bagCard,boxName,i); if i==3 then div:Destroy() end
            local dot=Instance.new("Frame",row); dot.Size=UDim2.new(0,7,0,7)
            dot.Position=UDim2.new(0,26,0.5,-3.5); dot.BackgroundColor3=dexSelectedBox==boxName and C_GREEN or C_MUTED
            dot.BorderSizePixel=0; makeRound(dot,4); lbl.Position=UDim2.new(0,40,0,0); lbl.Size=UDim2.new(1,-60,1,0)
            if dexSelectedBox==boxName then
                local pill=makePill(row,"Active",true); pill.AnchorPoint=Vector2.new(1,0.5)
                pill.Position=UDim2.new(1,-10,0.5,-9); pill.AutomaticSize=Enum.AutomaticSize.X; pill.Size=UDim2.new(0,0,0,18)
            end
            local hitbox=Instance.new("TextButton",row); hitbox.Size=UDim2.new(1,0,1,0)
            hitbox.BackgroundTransparency=1; hitbox.Text=""; hitbox.ZIndex=2
            hitbox.MouseButton1Click:Connect(function()
                dexSelectedBox=boxName; refreshBagCard()
                if BagHighlightEnabled then applyBagHighlight(boxName) end
                Notify("Bag Selected",boxName.." is now active.",2,C_ACCENT)
            end)
        end
    end
    refreshBagCard()

    makeSectionLabel(Content,"Grind Controls",2)
    local ctrlCard=makeCard(Content,3)
    makeToggleRow(ctrlCard,"Bag Highlight",0,BagHighlightEnabled,function(val)
        BagHighlightEnabled=val
        if val then applyBagHighlight(dexSelectedBox); Notify("Bag Highlight ON","Selected bag is now outlined.",2,C_GREEN)
        else clearBagHighlights(); Notify("Bag Highlight OFF","Highlight removed.",2,C_MUTED) end
    end,"Outline the selected bag in the world",nil)

    local statusRow,_,statusDiv=makeFeatureRow(ctrlCard,"",1); statusDiv:Destroy()
    local statusDot=Instance.new("Frame",statusRow); statusDot.Size=UDim2.new(0,7,0,7)
    statusDot.Position=UDim2.new(0,12,0.5,-3.5); statusDot.BackgroundColor3=C_MUTED; statusDot.BorderSizePixel=0; makeRound(statusDot,4)
    local statusLbl=Instance.new("TextLabel",statusRow); statusLbl.Size=UDim2.new(1,-80,1,0)
    statusLbl.Position=UDim2.new(0,26,0,0); statusLbl.BackgroundTransparency=1
    statusLbl.Text="Idle — not grinding"; statusLbl.TextColor3=C_MUTED; statusLbl.TextSize=fs(11)
    statusLbl.Font=Enum.Font.GothamMedium; statusLbl.TextXAlignment=Enum.TextXAlignment.Left
    local grindPill=makePill(statusRow,"Idle",false); grindPill.AnchorPoint=Vector2.new(1,0.5)
    grindPill.Position=UDim2.new(1,-10,0.5,-9); grindPill.AutomaticSize=Enum.AutomaticSize.X; grindPill.Size=UDim2.new(0,0,0,18)

    local grindBtn=Instance.new("TextButton",Content)
    grindBtn.Size=UDim2.new(1,0,0,36); grindBtn.BackgroundColor3=C_ACCENT
    grindBtn.Text="▶  START GRIND"; grindBtn.TextColor3=C_TEXT; grindBtn.TextSize=fs(12)
    grindBtn.Font=Enum.Font.GothamBold; grindBtn.BorderSizePixel=0; grindBtn.LayoutOrder=4
    makeRound(grindBtn,8); makeStroke(grindBtn,C_ACCENT_DK,1)
    attachTooltip(grindBtn,"Start or stop the dex grinding loop for the selected bag")
    grindBtn.MouseEnter:Connect(function() if not dexGrindActive then TweenService:Create(grindBtn,TweenInfo.new(0.12),{BackgroundColor3=C_ACCENT_DK}):Play() end end)
    grindBtn.MouseLeave:Connect(function() if not dexGrindActive then TweenService:Create(grindBtn,TweenInfo.new(0.12),{BackgroundColor3=C_ACCENT}):Play() end end)
    grindBtn.MouseButton1Click:Connect(function()
        dexGrindActive=not dexGrindActive
        if dexGrindActive then
            grindBtn.Text="⏹  STOP GRIND"
            TweenService:Create(grindBtn,TweenInfo.new(0.2),{BackgroundColor3=C_RED}):Play()
            statusDot.BackgroundColor3=C_GREEN; statusLbl.Text="Grinding "..dexSelectedBox; statusLbl.TextColor3=C_GREEN
            grindPill.Text=" Running "; grindPill.TextColor3=C_GREEN; grindPill.BackgroundColor3=Color3.fromRGB(20,60,35)
            if BagHighlightEnabled then applyBagHighlight(dexSelectedBox) end
            Notify("Dex Farm Started","Grinding "..dexSelectedBox.."...",3,C_GREEN)
            task.spawn(function()
                while dexGrindActive do
                    local current,goal=dexGetNumbers()
                    if not goal or goal<=0 then statusLbl.Text="Waiting for target number..."; task.wait(1)
                    elseif current>=goal then
                        dexGrindActive=false; grindBtn.Text="▶  START GRIND"
                        TweenService:Create(grindBtn,TweenInfo.new(0.2),{BackgroundColor3=C_ACCENT}):Play()
                        statusDot.BackgroundColor3=C_GREEN; statusLbl.Text="✅ Goal reached!"; statusLbl.TextColor3=C_GREEN
                        grindPill.Text=" Done "; Notify("Goal Reached!",dexSelectedBox.." grind complete.",4,C_GREEN); break
                    else
                        local needed=(goal-current)//100
                        if needed>0 then dexSpace(); task.wait(0.75) else dexM1(); task.wait(0.10) end
                        local cur2,_=dexGetNumbers(); if goal and goal>0 then statusLbl.Text=string.format("Grinding %s — %d / %d",dexSelectedBox,cur2,goal) end
                    end
                end
            end)
        else
            grindBtn.Text="▶  START GRIND"
            TweenService:Create(grindBtn,TweenInfo.new(0.2),{BackgroundColor3=C_ACCENT}):Play()
            statusDot.BackgroundColor3=C_MUTED; statusLbl.Text="Idle — not grinding"; statusLbl.TextColor3=C_MUTED
            grindPill.Text=" Idle "; grindPill.TextColor3=C_MUTED; grindPill.BackgroundColor3=Color3.fromRGB(35,35,45)
            Notify("Dex Farm Stopped","Grind halted.",2,C_MUTED)
        end
        logAction((dexGrindActive and "Started" or "Stopped").." Dex Grind "..dexSelectedBox)
    end)

    makeSectionLabel(Content,"Info",5)
    local infoCard=makeCard(Content,6)
    local i1,l1,_=makeFeatureRow(infoCard,"Reads orange goal number from bag TV",0)
    local i2,l2,_=makeFeatureRow(infoCard,"Heavy hits (×100) then light hits to finish",1)
