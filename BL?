local FpsSnapshot={Applied=false,DescConnection=nil,Parts={},Meshes={},Decals={},Effects={},Lighting={},Terrain={}}
local function takeSnapshot()
    FpsSnapshot.Parts={}; FpsSnapshot.Meshes={}; FpsSnapshot.Decals={}; FpsSnapshot.Effects={}
    for _,v in next,Workspace:GetDescendants() do pcall(function()
        if v:IsA("BasePart") and not v:IsA("MeshPart") then table.insert(FpsSnapshot.Parts,{inst=v,CastShadow=v.CastShadow,Material=v.Material,Reflectance=v.Reflectance,MaterialVariant=v.MaterialVariant})
        elseif v:IsA("MeshPart") then table.insert(FpsSnapshot.Meshes,{inst=v,CastShadow=v.CastShadow,DoubleSided=v.DoubleSided,RenderFidelity=v.RenderFidelity,TextureID=v.TextureID})
        elseif v:IsA("Decal") or v:IsA("Texture") then table.insert(FpsSnapshot.Decals,{inst=v,Transparency=v.Transparency})
        elseif v:IsA("Fire") or v:IsA("SpotLight") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then table.insert(FpsSnapshot.Effects,{inst=v,Enabled=v.Enabled}) end
    end) end
    local L=game:GetService("Lighting"); FpsSnapshot.Lighting={GlobalShadows=L.GlobalShadows,FogEnd=L.FogEnd,Brightness=L.Brightness}
    local T2=Workspace:FindFirstChildOfClass("Terrain"); if T2 then FpsSnapshot.Terrain={WaterReflectance=T2.WaterReflectance,WaterTransparency=T2.WaterTransparency,WaterWaveSize=T2.WaterWaveSize,WaterWaveSpeed=T2.WaterWaveSpeed} end
end
local function stripDescendant(v)
    pcall(function()
        if v:IsA("Model") then v.LevelOfDetail="Disabled"; v.ModelStreamingMode="Nonatomic"
        elseif v:IsA("BasePart") and not v:IsA("MeshPart") then v.CastShadow=false; v.Material="Plastic"; v.Reflectance=0; v.MaterialVariant=""
        elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency=1
        elseif v:IsA("MeshPart") then v.CastShadow=false; v.DoubleSided=false; v.RenderFidelity="Performance"; v.TextureID=10385902758728957
        elseif v:IsA("SpecialMesh") then v.TextureId=0
        elseif v:IsA("ShirtGraphic") then v.Graphic=0
        elseif v:IsA("Shirt") or v:IsA("Pants") then v[v.ClassName.."Template"]=0
        elseif v:IsA("Fire") or v:IsA("SpotLight") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then v.Enabled=false
        elseif v:IsA("Explosion") then v.BlastPressure=1; v.BlastRadius=1
        elseif v:IsA("SurfaceAppearance") or v:IsA("Debris") or v:IsA("MaterialVariant") then v:Destroy()
        elseif v:IsA("Attachment") then v.Visible=false end
    end)
end

