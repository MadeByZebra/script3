SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local q=SearchBox.Text:lower()
    for _,entry in ipairs(allSideItems) do
        local matches=q=="" or entry.name:lower():find(q,1,true) or entry.lbl.Text:lower():find(q,1,true)
        -- dim non-matching instead of hiding
        TweenService:Create(entry.lbl,TweenInfo.new(0.1),{
            TextColor3=matches and (entry.accent.Visible and C_TEXT or C_MUTED) or Color3.fromRGB(40,44,60)
