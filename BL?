        pcall(function() local T2=Workspace:FindFirstChildOfClass("Terrain"); if T2 then sethiddenproperty(T2,"Decoration",false); T2.WaterReflectance=0; T2.WaterTransparency=0.7; T2.WaterWaveSize=0; T2.WaterWaveSpeed=0 end end)
