        local badgeLbl=Instance.new("TextLabel",badge); badgeLbl.Size=UDim2.new(1,0,1,0)
        badgeLbl.BackgroundTransparency=1; badgeLbl.Text=tostring(badgeCount)
        badgeLbl.TextColor3=Color3.fromRGB(255,255,255); badgeLbl.TextSize=8
        badgeLbl.Font=Enum.Font.GothamBold
    end
    item.MouseEnter:Connect(function()
        if not accent.Visible then TweenService:Create(lbl,TweenInfo.new(0.1),{TextColor3=Color3.fromRGB(180,190,210)}):Play() end
    end)
    item.MouseLeave:Connect(function()
        if not accent.Visible then TweenService:Create(lbl,TweenInfo.new(0.1),{TextColor3=C_MUTED}):Play() end
    end)
    item.MouseButton1Click:Connect(function() if callback then callback(item,accent,lbl,iconLbl) end end)
    return item, accent, lbl, iconLbl
end

