    local wrapper=Instance.new("Frame",parent); wrapper.Size=UDim2.new(1,0,0,0)
    wrapper.AutomaticSize=Enum.AutomaticSize.Y; wrapper.BackgroundTransparency=1
    wrapper.BorderSizePixel=0; wrapper.LayoutOrder=order or 0
    makeList(wrapper,Enum.FillDirection.Vertical,0)

    local header=Instance.new("TextButton",wrapper); header.Size=UDim2.new(1,0,0,30)
    header.BackgroundColor3=C_CARD; header.BorderSizePixel=0; header.Text=""
    makeRound(header,8); makeStroke(header,C_STROKE,1)
    local hLbl=Instance.new("TextLabel",header); hLbl.Size=UDim2.new(1,-32,1,0)
    hLbl.Position=UDim2.new(0,12,0,0); hLbl.BackgroundTransparency=1; hLbl.Text=headerText
    hLbl.TextColor3=C_TEXT; hLbl.TextSize=fs(11); hLbl.Font=Enum.Font.GothamBold
    hLbl.TextXAlignment=Enum.TextXAlignment.Left
    local arrow=Instance.new("TextLabel",header); arrow.Size=UDim2.new(0,20,1,0)
    arrow.Position=UDim2.new(1,-24,0,0); arrow.BackgroundTransparency=1
    arrow.Text=startCollapsed and "▸" or "▾"; arrow.TextColor3=C_MUTED
    arrow.TextSize=fs(12); arrow.Font=Enum.Font.GothamBold; arrow.TextXAlignment=Enum.TextXAlignment.Center

    local body=Instance.new("Frame",wrapper); body.Size=UDim2.new(1,0,0,0)
    body.AutomaticSize=Enum.AutomaticSize.Y; body.BackgroundColor3=C_CARD
    body.BorderSizePixel=0; body.Visible=not startCollapsed
    makeRound(body,8); makeStroke(body,C_STROKE,1); makeList(body,Enum.FillDirection.Vertical,0)

    header.MouseButton1Click:Connect(function()
        body.Visible=not body.Visible
        arrow.Text=body.Visible and "▾" or "▸"
    end)
    return body, wrapper
end

local function makeFeatureRow(card,labelText,order)
    local row=Instance.new("Frame",card); row.Size=UDim2.new(1,0,0,34)
    row.BackgroundTransparency=1; row.BorderSizePixel=0; row.LayoutOrder=order or 0
    local div=Instance.new("Frame",row); div.Size=UDim2.new(1,-24,0,1)
    div.Position=UDim2.new(0,12,1,-1); div.BackgroundColor3=C_STROKE
    div.BackgroundTransparency=0.45; div.BorderSizePixel=0
    local lbl=Instance.new("TextLabel",row); lbl.Size=UDim2.new(1,-20,1,0)
    lbl.Position=UDim2.new(0,12,0,0); lbl.BackgroundTransparency=1; lbl.Text=labelText
    lbl.TextColor3=C_TEXT; lbl.TextSize=fs(11); lbl.Font=Enum.Font.GothamMedium
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    return row, lbl, div
end

local function makeToggleRow(card,labelText,order,defaultOn,callback,tooltipText,featureKey)
    local row,lbl,div=makeFeatureRow(card,labelText,order)
    -- Star favorite button
    if featureKey then
        local starBtn=Instance.new("TextButton",row); starBtn.Size=UDim2.new(0,16,0,16)
        starBtn.Position=UDim2.new(0,-2,0.5,-8); starBtn.BackgroundTransparency=1
        starBtn.Text=isFavorite(featureKey) and "★" or "☆"; starBtn.TextColor3=isFavorite(featureKey) and C_YELLOW or C_MUTED
        starBtn.TextSize=fs(12); starBtn.Font=Enum.Font.GothamBold; starBtn.ZIndex=3
        starBtn.MouseButton1Click:Connect(function()
            toggleFavorite(featureKey)
            starBtn.Text=isFavorite(featureKey) and "★" or "☆"
            starBtn.TextColor3=isFavorite(featureKey) and C_YELLOW or C_MUTED
        end)
        lbl.Position=UDim2.new(0,20,0,0); lbl.Size=UDim2.new(1,-40,1,0)
    end
    local box=Instance.new("Frame",row); box.Size=UDim2.new(0,14,0,14)
    box.Position=UDim2.new(1,-26,0.5,-7); box.BackgroundColor3=defaultOn and C_ACCENT or C_CARD
    box.BorderSizePixel=0; makeRound(box,3); makeStroke(box,defaultOn and C_ACCENT or C_MUTED,1)
    local chk=Instance.new("TextLabel",box); chk.Size=UDim2.new(1,0,1,0)
    chk.BackgroundTransparency=1; chk.Text=defaultOn and "✓" or ""; chk.TextColor3=Color3.fromRGB(255,255,255)
    chk.TextSize=10; chk.Font=Enum.Font.GothamBold; chk.TextXAlignment=Enum.TextXAlignment.Center
    local state=defaultOn
    local hitbox=Instance.new("TextButton",row); hitbox.Size=UDim2.new(1,0,1,0)
    hitbox.BackgroundTransparency=1; hitbox.Text=""; hitbox.ZIndex=2
    if tooltipText then attachTooltip(hitbox,tooltipText) end
    hitbox.MouseButton1Click:Connect(function()
        state=not state
        TweenService:Create(box,TweenInfo.new(0.15),{BackgroundColor3=state and C_ACCENT or C_CARD}):Play()
        local s=box:FindFirstChildOfClass("UIStroke"); if s then s.Color=state and C_ACCENT or C_MUTED end
        chk.Text=state and "✓" or ""
        if callback then callback(state) end
        logAction((state and "ON" or "OFF").." — "..labelText)
    end)
    local function set(val)
        state=val
        TweenService:Create(box,TweenInfo.new(0.15),{BackgroundColor3=state and C_ACCENT or C_CARD}):Play()
        local s=box:FindFirstChildOfClass("UIStroke"); if s then s.Color=state and C_ACCENT or C_MUTED end
        chk.Text=state and "✓" or ""
    end
    return row, set
end

