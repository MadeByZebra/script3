local function makeRightDropdown(labelText,options,current,order,callback)
    local wrap=Instance.new("Frame",RightScroll); wrap.Size=UDim2.new(1,0,0,0)
    wrap.AutomaticSize=Enum.AutomaticSize.Y; wrap.BackgroundTransparency=1
    wrap.BorderSizePixel=0; wrap.LayoutOrder=order or 0; makeList(wrap,Enum.FillDirection.Vertical,4)
    local lbl=Instance.new("TextLabel",wrap); lbl.Size=UDim2.new(1,0,0,14)
    lbl.BackgroundTransparency=1; lbl.Text=labelText; lbl.TextColor3=C_MUTED
    lbl.TextSize=fs(10); lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left
    local selected=current
    local dropFrame=Instance.new("Frame",wrap); dropFrame.Size=UDim2.new(1,0,0,28)
    dropFrame.BackgroundColor3=C_CARD; dropFrame.BorderSizePixel=0
    makeRound(dropFrame,6); makeStroke(dropFrame,C_STROKE,1)
    local selLbl=Instance.new("TextLabel",dropFrame); selLbl.Size=UDim2.new(1,-24,1,0)
    selLbl.Position=UDim2.new(0,10,0,0); selLbl.BackgroundTransparency=1
    selLbl.Text=selected; selLbl.TextColor3=C_TEXT; selLbl.TextSize=fs(11)
    selLbl.Font=Enum.Font.GothamMedium; selLbl.TextXAlignment=Enum.TextXAlignment.Left
    local arrow=Instance.new("TextLabel",dropFrame); arrow.Size=UDim2.new(0,18,1,0)
    arrow.Position=UDim2.new(1,-20,0,0); arrow.BackgroundTransparency=1
    arrow.Text="▾"; arrow.TextColor3=C_MUTED; arrow.TextSize=10
    arrow.Font=Enum.Font.GothamBold; arrow.TextXAlignment=Enum.TextXAlignment.Center
    local optList=Instance.new("Frame",wrap); optList.Size=UDim2.new(1,0,0,0)
    optList.AutomaticSize=Enum.AutomaticSize.Y; optList.BackgroundColor3=C_PANEL
    optList.BorderSizePixel=0; optList.Visible=false
    makeRound(optList,6); makeStroke(optList,C_STROKE,1); makeList(optList,Enum.FillDirection.Vertical,0)
    for _,opt in ipairs(options) do
        local obtn=Instance.new("TextButton",optList); obtn.Size=UDim2.new(1,0,0,26)
        obtn.BackgroundTransparency=1; obtn.Text=opt
        obtn.TextColor3=opt==selected and C_ACCENT or C_TEXT; obtn.TextSize=fs(11)
        obtn.Font=Enum.Font.GothamMedium; obtn.TextXAlignment=Enum.TextXAlignment.Left
        makePadding(obtn,0,0,10,0)
        obtn.MouseButton1Click:Connect(function()
            selected=opt; selLbl.Text=opt; optList.Visible=false
            for _,c in ipairs(optList:GetChildren()) do
                if c:IsA("TextButton") then c.TextColor3=c.Text==opt and C_ACCENT or C_TEXT end
            end
            if callback then callback(opt) end
        end)
    end
    local dropBtn=Instance.new("TextButton",dropFrame); dropBtn.Size=UDim2.new(1,0,1,0)
    dropBtn.BackgroundTransparency=1; dropBtn.Text=""; dropBtn.ZIndex=2
    dropBtn.MouseButton1Click:Connect(function() optList.Visible=not optList.Visible end)
    return wrap
end

local function makeRightSlider(labelText,min,max,current,suffix,order,callback)
    local wrap=Instance.new("Frame",RightScroll); wrap.Size=UDim2.new(1,0,0,0)
    wrap.AutomaticSize=Enum.AutomaticSize.Y; wrap.BackgroundTransparency=1
    wrap.BorderSizePixel=0; wrap.LayoutOrder=order or 0; makeList(wrap,Enum.FillDirection.Vertical,6)
    local header=Instance.new("Frame",wrap); header.Size=UDim2.new(1,0,0,14)
    header.BackgroundTransparency=1; header.BorderSizePixel=0
    local hl=Instance.new("UIListLayout",header); hl.FillDirection=Enum.FillDirection.Horizontal
    hl.HorizontalAlignment=Enum.HorizontalAlignment.Left
    local lbl=Instance.new("TextLabel",header); lbl.Size=UDim2.new(0.7,0,1,0)
    lbl.BackgroundTransparency=1; lbl.Text=labelText; lbl.TextColor3=C_MUTED
    lbl.TextSize=fs(10); lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left
    local valLbl=Instance.new("TextLabel",header); valLbl.Size=UDim2.new(0.3,0,1,0)
    valLbl.BackgroundTransparency=1; valLbl.Text=tostring(current)..(suffix or "")
    valLbl.TextColor3=C_TEXT; valLbl.TextSize=fs(10); valLbl.Font=Enum.Font.GothamBold
    valLbl.TextXAlignment=Enum.TextXAlignment.Right
    local track=Instance.new("Frame",wrap); track.Size=UDim2.new(1,0,0,14)
    track.BackgroundColor3=C_CARD; track.BorderSizePixel=0; makeRound(track,7); makeStroke(track,C_STROKE,1)
    local fill=Instance.new("Frame",track); fill.Size=UDim2.new((current-min)/(max-min),0,1,0)
    fill.BackgroundColor3=C_ACCENT; fill.BorderSizePixel=0; makeRound(fill,7)
    local thumb=Instance.new("Frame",track); thumb.Size=UDim2.new(0,14,0,14)
    thumb.Position=UDim2.new((current-min)/(max-min),-7,0,0)
    thumb.BackgroundColor3=Color3.fromRGB(255,255,255); thumb.BorderSizePixel=0; makeRound(thumb,7)
    local dragging3=false
    local function updateSlider(x)
        local rel=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local val=math.floor(min+rel*(max-min))
        fill.Size=UDim2.new(rel,0,1,0); thumb.Position=UDim2.new(rel,-7,0,0)
        valLbl.Text=tostring(val)..(suffix or "")
        if callback then callback(val) end
    end
    thumb.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then dragging3=true end end)
    UIS.InputChanged:Connect(function(inp) if dragging3 and inp.UserInputType==Enum.UserInputType.MouseMovement then updateSlider(inp.Position.X) end end)
    UIS.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then dragging3=false end end)
    track.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then updateSlider(inp.Position.X) end end)
    return wrap
end

