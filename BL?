    for _,l in ipairs({l1,l2,l3}) do l.TextColor3=C_MUTED; l.Font=Enum.Font.Gotham end

    makeRightSection("Bag Settings",0)
    makeRightDropdown("Target Bag",{"BOX1","BOX2","BOX3"},dexSelectedBox,1,function(opt) dexSelectedBox=opt; if BagHighlightEnabled then applyBagHighlight(opt) end end)
    makeRightSection("Overlay",5)
    makeButtonRow(makeCard(RightScroll,6),"Spawn Dex Overlay",0,function() spawnDexOverlay(); Notify("Dex Overlay","Floating overlay spawned.",2,C_GREEN) end)
    makeRightSection("Session",10)
    local tc=Instance.new("Frame",RightScroll); tc.Size=UDim2.new(1,0,0,28); tc.BackgroundColor3=C_CARD
    tc.BorderSizePixel=0; tc.LayoutOrder=11; makeRound(tc,6); makeStroke(tc,C_STROKE,1)
    local tl=Instance.new("TextLabel",tc); tl.Size=UDim2.new(1,-10,1,0); tl.Position=UDim2.new(0,10,0,0)
    tl.BackgroundTransparency=1; tl.Text="⏱ "..getSessionTime(); tl.TextColor3=C_MUTED
    tl.TextSize=fs(10); tl.Font=Enum.Font.GothamMedium; tl.TextXAlignment=Enum.TextXAlignment.Left
    RunService.Heartbeat:Connect(function() if tl and tl.Parent then tl.Text="⏱ "..getSessionTime() end end)
end

