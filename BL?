    lbl.Position=UDim2.new(0,34,0,0); lbl.BackgroundTransparency=1
    lbl.Text=text; lbl.TextColor3=C_MUTED; lbl.TextSize=fs(11)
    lbl.Font=Enum.Font.GothamMedium; lbl.TextXAlignment=Enum.TextXAlignment.Left
    -- Badge counter
    local badge=nil
    if badgeCount and badgeCount>0 then
        badge=Instance.new("Frame",item); badge.Size=UDim2.new(0,16,0,14)
        badge.Position=UDim2.new(1,-18,0.5,-7); badge.BackgroundColor3=C_RED; badge.BorderSizePixel=0
